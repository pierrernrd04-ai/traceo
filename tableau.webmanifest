{
  "name": "Traceo Admin",
  "short_name": "Traceo Admin",
  "description": "Tableau de bord de Traceo et alertes en notification (inscriptions, visiteurs, paiements, signalements).",
  "lang": "fr",
  "id": "/tableau",
  "start_url": "/tableau",
  "scope": "/",
  "display": "standalone",
